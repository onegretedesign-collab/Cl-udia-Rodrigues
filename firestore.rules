rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrap admin without DB lookup (safe for allow list)
    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'onegretedesign@gmail.com';
    }

    // Full admin check for single-document operations
    function isAdmin() {
      return isBootstrapAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Blueprints (synchronized with firebase-blueprint.json) ---
    function isValidServiceId(serviceId) {
      return serviceId is string && serviceId in [
        'brow-lamination',
        'maquiagem',
        'extensao-cilios',
        'lash-lifting'
      ];
    }

    function isValidStatus(status) {
      return status is string && status in ['pending', 'confirmed', 'completed', 'cancelled'];
    }

    function isValidReminderMinutes(mins) {
      return mins is number && mins in [15, 30, 60, 1440];
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'ownerId',
          'clientName',
          'clientCpf',
          'clientPhone',
          'serviceId',
          'serviceName',
          'date',
          'startTime',
          'durationMinutes',
          'price',
          'status',
          'notes',
          'reminderMinutesBefore',
          'reminderEnabled',
          'calendarSynced',
          'googleCalendarEventId',
          'googleCalendarHtmlLink',
          'whatsappSent',
          'ownerSeen',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'clientName',
          'clientCpf',
          'clientPhone',
          'serviceId',
          'serviceName',
          'date',
          'startTime',
          'durationMinutes',
          'price',
          'status',
          'notes',
          'reminderMinutesBefore',
          'reminderEnabled',
          'calendarSynced',
          'googleCalendarEventId',
          'googleCalendarHtmlLink',
          'whatsappSent',
          'ownerSeen',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data.clientCpf is string && data.clientCpf.size() == 14 &&
        data.clientCpf.matches('^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$') &&
        data.clientPhone is string && data.clientPhone.size() >= 8 && data.clientPhone.size() <= 24 &&
        data.clientPhone.matches('^[0-9+()\\-\\s]{8,24}$') &&
        isValidServiceId(data.serviceId) &&
        data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 80 &&
        data.date is string && data.date.size() == 10 &&
        data.date.matches('^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        data.startTime is string && data.startTime.size() == 5 &&
        data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.durationMinutes is number && data.durationMinutes >= 30 && data.durationMinutes <= 240 &&
        data.price is number && data.price >= 0 && data.price <= 10000 &&
        isValidStatus(data.status) &&
        data.notes is string && data.notes.size() <= 400 &&
        isValidReminderMinutes(data.reminderMinutesBefore) &&
        data.reminderEnabled is bool &&
        data.calendarSynced is bool &&
        data.googleCalendarEventId is string && data.googleCalendarEventId.size() <= 256 &&
        data.googleCalendarHtmlLink is string && data.googleCalendarHtmlLink.size() <= 512 &&
        (data.googleCalendarHtmlLink == '' || data.googleCalendarHtmlLink.matches('^https://.*')) &&
        data.whatsappSent is bool &&
        data.ownerSeen is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data) {
      return data.keys().hasAll([
          'userId',
          'pushEnabled',
          'defaultReminderMinutes',
          'calendarProvider',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'pushEnabled',
          'defaultReminderMinutes',
          'calendarProvider',
          'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.pushEnabled is bool &&
        isValidReminderMinutes(data.defaultReminderMinutes) &&
        data.calendarProvider is string && data.calendarProvider in ['google', 'apple', 'outlook'] &&
        data.updatedAt is timestamp;
    }

    // --- Collection: appointments ---
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() &&
        isValidId(appointmentId) &&
        (existing().ownerId == request.auth.uid || isAdmin());

      // Pillar 8: Explicitly validate resource.data without get()/exists()
      allow list: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isBootstrapAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(appointmentId) &&
        isValidAppointment(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status in ['pending', 'confirmed'] &&
        incoming().ownerSeen == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(appointmentId) &&
        isValidAppointment(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().ownerId == request.auth.uid &&
            existing().status != 'completed' &&
            existing().status != 'cancelled' && (
              // Action 1: Sync external Google Calendar metadata or WhatsApp dispatch flags
              (incoming().diff(existing()).affectedKeys().hasOnly([
                'calendarSynced',
                'googleCalendarEventId',
                'googleCalendarHtmlLink',
                'whatsappSent',
                'updatedAt'
              ])) ||
              // Action 2: Update push reminder settings
              (incoming().diff(existing()).affectedKeys().hasOnly([
                'reminderEnabled',
                'reminderMinutesBefore',
                'updatedAt'
              ])) ||
              // Action 3: Reschedule or edit notes while active
              (incoming().diff(existing()).affectedKeys().hasOnly([
                'date',
                'startTime',
                'notes',
                'calendarSynced',
                'googleCalendarEventId',
                'googleCalendarHtmlLink',
                'updatedAt'
              ])) ||
              // Action 4: Client cancels or confirms own appointment
              (incoming().status in ['confirmed', 'cancelled'] &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'status',
                  'calendarSynced',
                  'googleCalendarEventId',
                  'googleCalendarHtmlLink',
                  'updatedAt'
                ]))
            )
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(appointmentId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }

    // --- Collection: userPreferences ---
    match /userPreferences/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        (userId == request.auth.uid || isAdmin());

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserPreferences(incoming()) &&
        userId == request.auth.uid &&
        incoming().userId == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserPreferences(incoming()) &&
        userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'pushEnabled',
          'defaultReminderMinutes',
          'calendarProvider',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        (userId == request.auth.uid || isAdmin());
    }

    // --- Collection: admins (read-only self lookup) ---
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list, create, update, delete: if false;
    }
  }
}
